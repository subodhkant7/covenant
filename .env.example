# ==============================================================================
# Covenant Runtime Environment Configuration
# ==============================================================================
# Copy this file to .env for local overrides. Defaults are configured for
# immediate offline execution without external API keys or cloud credentials.

# ------------------------------------------------------------------------------
# 1. Model Provider Selection
# ------------------------------------------------------------------------------
# Options:
#   deterministic  - Native offline Strands model (Default, zero external deps)
#   ollama         - Local Ollama model server
#   bedrock        - Amazon Bedrock via native Strands BedrockModel
COVENANT_MODEL_PROVIDER=deterministic

# ------------------------------------------------------------------------------
# 2. Local Ollama Configuration (when COVENANT_MODEL_PROVIDER=ollama)
# ------------------------------------------------------------------------------
COVENANT_OLLAMA_BASE_URL=http://localhost:11434
COVENANT_OLLAMA_MODEL=llama3:latest

# ------------------------------------------------------------------------------
# 3. Amazon Bedrock Configuration (when COVENANT_MODEL_PROVIDER=bedrock)
# ------------------------------------------------------------------------------
# Model ID to invoke on Amazon Bedrock
COVENANT_BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# AWS Region for Bedrock calls
COVENANT_AWS_REGION=us-east-1

# Optional inference hyperparameters
COVENANT_BEDROCK_TEMPERATURE=0.1
# COVENANT_BEDROCK_MAX_TOKENS=2048

# Standard AWS credentials (resolved automatically via standard AWS chain:
# environment variables, ~/.aws/credentials, or EC2/ECS IAM role).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ------------------------------------------------------------------------------
# 4. Database & Storage Configuration
# ------------------------------------------------------------------------------
# SQLite WAL database path (defaults to ./covenant.db)
# DATABASE_URL=sqlite:///./covenant.db

# ------------------------------------------------------------------------------
# 5. Application & Workspace Identity
# ------------------------------------------------------------------------------
COVENANT_SYSTEM_USER_ORG=Northstar Studio
COVENANT_SYSTEM_USER_NAME=Alex North
COVENANT_SYSTEM_USER_EMAIL=alex@northstarstudio.com
COVENANT_AUTO_SCAN_INTERVAL_SECONDS=300
